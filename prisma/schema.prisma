
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String           @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  name            String
  email           String
  emailVerified   Boolean          @default(false)
  image           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  isSuspended     Boolean          @default(false)
  sessions        Session[]
  accounts        Account[]
  customerProfile CustomerProfile?

  phoneNumber         String?
  phoneNumberVerified Boolean?

  twoFactorEnabled Boolean?    @default(false)
  twofactors       TwoFactor[]

  internalStaffMembership InternalStaffMembership?
  securityAuditEvents     SecurityAuditEvent[]
  createdProviders        ProviderOrganization[]   @relation("ProviderCreatedBy")
  submittedProviders      ProviderOrganization[]   @relation("ProviderSubmittedBy")
  activatedProviders      ProviderOrganization[]   @relation("ProviderActivatedBy")
  vettedBranches          ProviderBranch[]         @relation("BranchVettedBy")
  createdServiceDefinitions ServiceDefinition[]    @relation("ServiceDefinitionCreatedBy")
  updatedServiceDefinitions ServiceDefinition[]    @relation("ServiceDefinitionUpdatedBy")
  createdOffers             Offer[]                  @relation("OfferCreatedBy")
  createdOfferRevisions     OfferRevision[]          @relation("OfferRevisionCreatedBy")
  submittedOfferRevisions   OfferRevision[]          @relation("OfferRevisionSubmittedBy")
  decidedOfferRevisions     OfferRevision[]          @relation("OfferRevisionDecidedBy")

  @@unique([email])
  @@unique([phoneNumber])
  @@map("user")
}

model Session {
  id                    String    @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  expiresAt             DateTime
  token                 String
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  ipAddress             String?
  userAgent             String?
  userId                String    @db.Uuid
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastActivityAt        DateTime
  lastReauthenticatedAt DateTime?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  accountId             String
  providerId            String
  userId                String    @db.Uuid
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

enum OtpPurpose {
  CUSTOMER_AUTH
}

enum OtpChallengeStatus {
  PENDING
  ACTIVE
  CONSUMED
  EXPIRED
  LOCKED
  SUPERSEDED
  DELIVERY_FAILED
  DELIVERY_UNKNOWN
}

model OtpChallenge {
  id                     String             @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  phoneLookupHash        String             @db.VarChar(64)
  purpose                OtpPurpose         @default(CUSTOMER_AUTH)
  status                 OtpChallengeStatus @default(PENDING)
  codeHash               String             @db.VarChar(64)
  dispatchId             String             @unique @db.VarChar(64)
  expiresAt              DateTime
  cooldownUntil          DateTime
  dispatchLeaseExpiresAt DateTime?
  lockoutUntil           DateTime?
  failedAttemptCount     Int                @default(0)
  sendCount              Int                @default(1)
  consumedAt             DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  @@index([phoneLookupHash, status])
  @@index([expiresAt])
  @@map("otp_challenge")
}

model CustomerProfile {
  id                      String   @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  userId                  String   @unique @db.Uuid
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  preferredLanguage       String   @default("ar") @db.VarChar(5)
  notificationPreferences Json     @default("{\"sms\": true, \"whatsapp\": false}")
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@map("customer_profile")
}

model RateLimitBucket {
  key       String   @id @db.VarChar(128)
  points    Int      @default(0)
  expireAt  DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expireAt])
  @@map("rate_limit_bucket")
}

model TwoFactor {
  id                      String    @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  secret                  String
  backupCodes             String
  userId                  String    @db.Uuid
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime?

  @@index([secret])
  @@index([userId])
  @@map("twoFactor")
}

enum StaffDepartment {
  SALES
  OPERATIONS
  FINANCE
  ADMIN
}

enum StaffRole {
  SALES_AGENT
  OPS_SUPERVISOR
  FINANCE_OFFICER
  PLATFORM_ADMIN
}

model InternalStaffMembership {
  id                 String                   @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  userId             String                   @unique @db.Uuid
  user               User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeNumber     String                   @unique @db.VarChar(64)
  department         StaffDepartment
  isActive           Boolean                  @default(true)
  mustChangePassword Boolean                  @default(true)
  hiredAt            DateTime                 @default(now())
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  roleAssignments    InternalRoleAssignment[]

  @@map("internal_staff_membership")
}

model InternalRoleAssignment {
  id                String                  @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  staffMembershipId String                  @db.Uuid
  staffMembership   InternalStaffMembership @relation(fields: [staffMembershipId], references: [id], onDelete: Cascade)
  role              StaffRole
  isActive          Boolean                 @default(true)
  assignedAt        DateTime                @default(now())
  assignedBy        String?                 @db.VarChar(64)
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  @@index([staffMembershipId, isActive])
  @@map("internal_role_assignments")
}

model SecurityAuditEvent {
  id            String   @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  actorUserId   String?  @db.Uuid
  actorUser     User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  eventType     String   @db.VarChar(64)
  targetEntity  String?  @db.VarChar(128)
  ipFingerprint String?  @db.VarChar(64)
  metadata      Json     @default("{}")
  timestamp     DateTime @default(now())

  @@index([timestamp])
  @@index([eventType, timestamp])
  @@index([actorUserId, timestamp])
  @@index([ipFingerprint, eventType, timestamp])
  @@map("security_audit_events")
}

enum ProviderStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  PAUSED
  REJECTED
  TERMINATED
}

enum BranchStatus {
  DRAFT
  ACTIVE
  PAUSED
  DECOMMISSIONED
}

enum CairoCluster {
  NASR_CITY_HELIOPOLIS
  NEW_CAIRO
  MAADI
  OCTOBER_ZAYED
}

enum ServicePricingMode {
  FIXED_SCOPE
  QUOTE_REQUIRED
}

enum OfferRevisionStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum OfferBookingRule {
  APPOINTMENT_REQUIRED
  WALK_IN_ALLOWED
  CONTACT_TO_BOOK
}

enum OfferEvidenceType {
  PROVIDER_PRICE_LIST
  WRITTEN_QUOTE
  PROVIDER_WRITTEN_CONFIRMATION
  OTHER
}

enum OfferCommissionBasis {
  DISCOUNTED_CUSTOMER_PRICE
}

model ProviderOrganization {
  id                           String         @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  nameEn                       String         @db.VarChar(128)
  nameAr                       String         @db.VarChar(128)
  legalName                    String         @db.VarChar(255)
  taxRegistrationNumber        String         @unique @db.VarChar(9)
  commercialRegistrationNumber String         @unique @db.VarChar(32)
  primaryCluster               CairoCluster
  status                       ProviderStatus @default(DRAFT)
  version                      Int            @default(1)

  // Business Contact (Minimized, workshop business context only)
  contactPersonName            String         @db.VarChar(128)
  contactEmail                 String         @db.VarChar(255)
  contactPhone                 String         @db.VarChar(20)

  // Maker-Checker & Audit Tracking
  createdByUserId              String         @db.Uuid
  createdByUser                User           @relation("ProviderCreatedBy", fields: [createdByUserId], references: [id])
  submittedByUserId            String?        @db.Uuid
  submittedByUser              User?          @relation("ProviderSubmittedBy", fields: [submittedByUserId], references: [id])
  activatedByUserId            String?        @db.Uuid
  activatedByUser              User?          @relation("ProviderActivatedBy", fields: [activatedByUserId], references: [id])

  rejectionReason              String?        @db.Text
  pauseReason                  String?        @db.Text

  submittedAt                  DateTime?
  activatedAt                  DateTime?
  pausedAt                     DateTime?
  createdAt                    DateTime       @default(now())
  updatedAt                    DateTime       @updatedAt

  branches                     ProviderBranch[]
  offers                       Offer[]

  @@index([status, primaryCluster])
  @@index([createdByUserId])
  @@map("provider_organizations")
}

model ProviderBranch {
  id                     String               @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  providerOrganizationId String               @db.Uuid
  providerOrganization   ProviderOrganization @relation(fields: [providerOrganizationId], references: [id], onDelete: Cascade)

  branchCode             String               @db.VarChar(32)
  nameEn                 String               @db.VarChar(128)
  nameAr                 String               @db.VarChar(128)
  cluster                CairoCluster

  // Physical Location & Coordinates
  streetAddressEn        String               @db.VarChar(255)
  streetAddressAr        String               @db.VarChar(255)
  landmarkEn             String?              @db.VarChar(255)
  landmarkAr             String?              @db.VarChar(255)
  latitude               Decimal              @db.Decimal(9, 6)
  longitude              Decimal              @db.Decimal(9, 6)

  // Contact Phone & Operating Hours
  contactPhone           String               @db.VarChar(20)
  operatingHours         Json

  status                 BranchStatus         @default(DRAFT)
  version                Int                  @default(1)
  pauseReason            String?              @db.Text
  rejectionReason        String?              @db.Text

  // Vetting Verification Record (Operations Checker)
  legalIdentityChecked    Boolean              @default(false)
  physicalLocationChecked Boolean              @default(false)
  contactAndHoursChecked  Boolean              @default(false)
  evidenceDocumentRef     String?              @db.VarChar(128)
  vettedByUserId          String?              @db.Uuid
  vettedByUser            User?                @relation("BranchVettedBy", fields: [vettedByUserId], references: [id])
  vettedAt                DateTime?

  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  @@unique([providerOrganizationId, branchCode])
  @@unique([id, providerOrganizationId])
  @@index([cluster, status])
  offers Offer[]
  @@map("provider_branches")
}

model ServiceCategory {
  id          String              @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  code        String              @unique @db.VarChar(48)
  nameEn      String              @db.VarChar(100)
  nameAr      String              @db.VarChar(100)
  sortOrder   Int                 @default(0)
  isActive    Boolean             @default(true)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  definitions ServiceDefinition[]

  @@index([isActive, sortOrder])
  @@map("service_categories")
}

model ServiceDefinition {
  id              String            @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  code            String            @unique @db.VarChar(64)
  categoryId      String            @db.Uuid
  category        ServiceCategory   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  nameEn          String            @db.VarChar(160)
  nameAr          String            @db.VarChar(160)
  scopeEn         String            @db.VarChar(1000)
  scopeAr         String            @db.VarChar(1000)
  pricingMode     ServicePricingMode
  itemSku         String?           @db.VarChar(80)
  isActive        Boolean           @default(true)
  version         Int               @default(1)
  createdByUserId String            @db.Uuid
  createdByUser   User              @relation("ServiceDefinitionCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  updatedByUserId String            @db.Uuid
  updatedByUser   User              @relation("ServiceDefinitionUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: Restrict)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  offers          Offer[]
  revisions       OfferRevision[]

  @@index([categoryId, isActive, nameEn])
  @@map("service_definitions")
}

model Offer {
  id                        String               @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  providerOrganizationId    String               @db.Uuid
  providerOrganization      ProviderOrganization @relation(fields: [providerOrganizationId], references: [id], onDelete: Restrict)
  branchId                  String               @db.Uuid
  branch                    ProviderBranch       @relation(fields: [branchId, providerOrganizationId], references: [id, providerOrganizationId], onDelete: Restrict)
  serviceDefinitionId       String               @db.Uuid
  serviceDefinition         ServiceDefinition    @relation(fields: [serviceDefinitionId], references: [id], onDelete: Restrict)
  createdByUserId           String               @db.Uuid
  createdByUser             User                 @relation("OfferCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  currentApprovedRevisionId String?              @db.Uuid
  currentApprovedRevision   OfferRevision?       @relation("CurrentApprovedOfferRevision", fields: [currentApprovedRevisionId, id], references: [id, offerId], onDelete: Restrict)
  revisions                 OfferRevision[]      @relation("OfferRevisions")
  nextRevisionNumber        Int                  @default(2)
  creationRequestId          String               @unique @db.Uuid
  createdAt                 DateTime             @default(now())
  updatedAt                 DateTime             @updatedAt

  @@unique([id, providerOrganizationId])
  @@index([providerOrganizationId, branchId, createdAt])
  @@map("offers")
}

model OfferRevision {
  id                      String                 @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  offerId                 String                 @db.Uuid
  offer                   Offer                  @relation("OfferRevisions", fields: [offerId], references: [id], onDelete: Restrict)
  revisionNumber          Int
  status                  OfferRevisionStatus    @default(DRAFT)
  version                 Int                    @default(1)
  requestId               String                 @unique @db.Uuid
  serviceDefinitionId     String                 @db.Uuid
  serviceDefinition       ServiceDefinition      @relation(fields: [serviceDefinitionId], references: [id], onDelete: Restrict)
  categoryCode            String                 @db.VarChar(48)
  categoryNameEn          String                 @db.VarChar(100)
  categoryNameAr          String                 @db.VarChar(100)
  serviceCode             String                 @db.VarChar(64)
  serviceNameEn           String                 @db.VarChar(160)
  serviceNameAr           String                 @db.VarChar(160)
  serviceScopeEn          String                 @db.VarChar(1000)
  serviceScopeAr          String                 @db.VarChar(1000)
  titleEn                 String                 @db.VarChar(160)
  titleAr                 String                 @db.VarChar(160)
  includedLaborEn         String                 @db.VarChar(1000)
  includedLaborAr         String                 @db.VarChar(1000)
  includedPartsEn         String                 @db.VarChar(1000)
  includedPartsAr         String                 @db.VarChar(1000)
  excludedLaborEn         String                 @db.VarChar(1000)
  excludedLaborAr         String                 @db.VarChar(1000)
  excludedPartsEn         String                 @db.VarChar(1000)
  excludedPartsAr         String                 @db.VarChar(1000)
  bookingRule             OfferBookingRule
  durationMinutes         Int
  validFrom               DateTime
  validUntil              DateTime
  normalPriceMinor        BigInt
  customerPriceMinor      BigInt
  evidencePacketId        String                 @db.VarChar(64)
  evidenceType            OfferEvidenceType
  evidenceDate            DateTime
  priceBasisNotes         String                 @db.VarChar(1000)
  commercialTermsPacketId String                 @db.VarChar(64)
  commercialTermsAgreedAt DateTime
  commissionBasis         OfferCommissionBasis
  commissionRateBps       Int
  createdByUserId         String                 @db.Uuid
  createdByUser           User                   @relation("OfferRevisionCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  submittedByUserId       String?                @db.Uuid
  submittedByUser         User?                  @relation("OfferRevisionSubmittedBy", fields: [submittedByUserId], references: [id], onDelete: Restrict)
  submittedAt             DateTime?
  decidedByUserId         String?                @db.Uuid
  decidedByUser           User?                  @relation("OfferRevisionDecidedBy", fields: [decidedByUserId], references: [id], onDelete: Restrict)
  decidedAt               DateTime?
  rejectionReason         String?                @db.VarChar(1000)
  evidenceInspected       Boolean                @default(false)
  priceVerified           Boolean                @default(false)
  scopeVerified           Boolean                @default(false)
  providerConsentVerified Boolean                @default(false)
  currentForOffers        Offer[]                @relation("CurrentApprovedOfferRevision")
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt

  @@unique([offerId, revisionNumber])
  @@unique([id, offerId])
  @@index([status, createdAt])
  @@index([offerId, status])
  @@map("offer_revisions")
}
