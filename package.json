{
  "name": "waffarhacars-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "prisma:migrate:status": "prisma migrate status",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "auth:schema:generate": "node node_modules/auth/dist/index.mjs generate --config src/lib/auth.schema.ts --output prisma/schema.prisma --adapter prisma --dialect postgresql -y",
    "auth:schema:check": "node scripts/check-auth-schema.mjs",
    "auth:cleanup": "node scripts/cleanup-auth.mjs",
    "db:test:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "db:test:down": "docker compose -f docker-compose.test.yml down -v",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"scripts/**/*.{js,mjs}\" \"eslint.config.mjs\" \"next.config.mjs\" \"playwright.config.ts\" \"vitest.config.mts\" \"vitest.integration.config.mts\" --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:watch": "vitest",
    "test:e2e": "node scripts/run-e2e.mjs",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test:unit && npm run prisma:validate && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "1.7.5",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "better-auth": "1.7.5",
    "clsx": "^2.1.1",
    "libphonenumber-js": "1.13.13",
    "lucide-react": "^0.468.0",
    "next": "^16.3.5",
    "pg": "8.23.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "0.0.1",
    "tailwind-merge": "^2.5.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.20.3",
    "@types/pg": "8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "auth": "1.7.5",
    "autoprefixer": "^10.6.1",
    "dotenv": "16.6.1",
    "eslint": "^9.16.0",
    "eslint-config-next": "^16.3.5",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "prettier": "^3.9.8",
    "prisma": "7.10.0",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "packageManager": "npm@11.15.0",
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "mysql2": "3.24.4"
  }
}
