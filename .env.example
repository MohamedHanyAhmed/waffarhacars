# ==============================================================================
# WaffarhaCars Environment Variables (Example Template)
# SAFE FOR VERSION CONTROL — DO NOT STORE REAL SECRETS IN THIS FILE
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. Runtime Profile & Backend Selection
# ------------------------------------------------------------------------------
# APP_RUNTIME_PROFILE: showcase | production (Commercial deployment discriminator)
APP_RUNTIME_PROFILE=showcase
# APP_DATA_BACKEND: demo | postgres (production profile strictly requires postgres)
APP_DATA_BACKEND=demo

# ------------------------------------------------------------------------------
# 3. PostgreSQL Runtime and Migration URLs
# ------------------------------------------------------------------------------
# DATABASE_URL: Pooled connection string used by application runtime Route Handlers
DATABASE_URL=postgresql://waffarha_user:example_password@localhost:5432/waffarhacars_dev?schema=public
# DATABASE_DIRECT_URL: Unpooled connection string required for Prisma migration operations
DATABASE_DIRECT_URL=postgresql://waffarha_user:example_password@localhost:5432/waffarhacars_dev?schema=public

# ------------------------------------------------------------------------------
# 4. Connection Pool & Timeouts
# ------------------------------------------------------------------------------
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=10000
DATABASE_STATEMENT_TIMEOUT_MS=5000

# ------------------------------------------------------------------------------
# 5. Authentication & Session (Better Auth 1.7.5)
# ------------------------------------------------------------------------------
# BETTER_AUTH_SECRET: High-entropy secret of at least 32 characters (mandatory for postgres backend)
BETTER_AUTH_SECRET=example-development-only-secret-do-not-use-in-production-min32
# BETTER_AUTH_URL: Absolute root origin URL with no query or fragment (HTTPS required in production)
BETTER_AUTH_URL=http://localhost:3000
# AUTH_TRUSTED_ORIGINS: Optional comma-separated list of additional allowed root origins
# AUTH_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# 6. Customer Mobile OTP Authentication (PR 2B)
# ------------------------------------------------------------------------------
# OTP_SMS_PROVIDER: dev_capture | test | mock_gateway | egyptian_gateway
OTP_SMS_PROVIDER=dev_capture
# Cryptographic secrets: Must be at least 32 characters and mutually distinct
OTP_PEPPER_SECRET=example-development-otp-pepper-secret-min32-chars
PHONE_ALIAS_HMAC_KEY=example-development-phone-alias-key-min32-chars
PHONE_LOOKUP_HMAC_KEY=example-development-phone-lookup-key-min32-chars
# Reverse proxy hops for trusted client IP resolution (e.g., 1 behind Nginx/Cloudflare)
TRUSTED_PROXY_HOPS=0
# Optional external SMS gateway parameters (when using live aggregator)
SMS_GATEWAY_API_URL=https://api.sms-gateway.example/v1
SMS_GATEWAY_API_KEY=example_gateway_api_key
SMS_GATEWAY_SENDER_ID=WaffarhaCars

# ------------------------------------------------------------------------------
# 7. Future Object Storage (Gate 3 - Provider Price Board Uploads)
# ------------------------------------------------------------------------------
STORAGE_PROVIDER=mock
S3_ENDPOINT=https://s3.example.com
S3_REGION=me-central-1
S3_BUCKET_NAME=waffarhacars-provider-docs-dev
S3_ACCESS_KEY_ID=example_access_key
S3_SECRET_ACCESS_KEY=example_secret_key

# ------------------------------------------------------------------------------
# 8. Playwright E2E Testing Configuration
# ------------------------------------------------------------------------------
PLAYWRIGHT_BASE_URL=http://localhost:3000
