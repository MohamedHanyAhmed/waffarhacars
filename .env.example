# Runtime Profile & Backend Selection
# APP_RUNTIME_PROFILE: showcase | production
APP_RUNTIME_PROFILE=showcase

# APP_DATA_BACKEND: demo | postgres
APP_DATA_BACKEND=demo

# PostgreSQL Connection Strings (Required when APP_DATA_BACKEND=postgres)
# DATABASE_URL: used for application runtime connection pooling
DATABASE_URL=postgresql://test_user:test_password@localhost:5432/waffarhacars_test

# DATABASE_DIRECT_URL: used for direct Prisma migration operations
DATABASE_DIRECT_URL=postgresql://test_user:test_password@localhost:5432/waffarhacars_test

# Connection Pool & Timeout Configurations
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=10000
DATABASE_STATEMENT_TIMEOUT_MS=5000
