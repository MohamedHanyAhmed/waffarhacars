# ==============================================================================
# WaffarhaCars Environment Variables (Example Template)
# SAFE FOR VERSION CONTROL — DO NOT STORE REAL SECRETS IN THIS FILE
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Future Database (Gate 1 - PostgreSQL)
DATABASE_URL=postgresql://waffarha_user:example_password@localhost:5432/waffarhacars_dev?schema=public

# Backend Data Adapter Mode (demo | postgres)
APP_DATA_BACKEND=demo

# Future Session & Authentication
# Must be a 32+ character random string in production
SESSION_SECRET=example-development-only-secret-do-not-use-in-production

# Future OTP Provider Adapter (Vendor evaluation pending)
# Neutral adapter placeholder
OTP_PROVIDER=mock
OTP_API_KEY=example_api_key_for_development
OTP_SENDER_ID=example_sender

# Future Object Storage (Gate 3 - Provider Price Board Uploads)
# S3-compatible private bucket configuration
STORAGE_PROVIDER=mock
S3_ENDPOINT=https://s3.example.com
S3_REGION=me-central-1
S3_BUCKET_NAME=waffarhacars-provider-docs-dev
S3_ACCESS_KEY_ID=example_access_key
S3_SECRET_ACCESS_KEY=example_secret_key

# Playwright E2E Testing Configuration
PLAYWRIGHT_BASE_URL=http://localhost:3000
